FROM oven/bun:1.3.11

WORKDIR /app

# Copy package files
COPY package.json bun.lock* ./
COPY apps/gateway/package.json ./apps/gateway/

# Install dependencies
RUN bun install

# Copy gateway source
COPY apps/gateway ./apps/gateway/

# Expose port
EXPOSE 4000

# Start gateway
CMD ["bun", "run", "apps/gateway/real-gateway.ts"]